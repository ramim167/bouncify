{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run BOUNCIFY",
      "type": "node-terminal",
      "request": "launch",
      "command": "cmd /d /c runner.bat",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "C/C++ Runner: Debug Session",
      "type": "cppdbg",
      "request": "launch",
      "args": [],
      "stopAtEntry": false,
      "externalConsole": true,
      "cwd": "c:/Users/User/OneDrive/Desktop/2-1/Modern-iGraphics-main",
      "program": "c:/Users/User/OneDrive/Desktop/2-1/Modern-iGraphics-main/build/Debug/outDebug",
      "MIMode": "gdb",
      "miDebuggerPath": "gdb",
      "setupCommands": [
        {
          "description": "Enable pretty-printing for gdb",
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        }
      ]
    }
  ]
}