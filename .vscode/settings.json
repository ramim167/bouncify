{
  "C_Cpp_Runner.cCompilerPath": "C:/MinGW/bin/gcc.exe",
  "C_Cpp_Runner.cppCompilerPath": "C:/MinGW/bin/g++.exe",
  "C_Cpp_Runner.debuggerPath": "gdb",
  "C_Cpp_Runner.cStandard": "",
  "C_Cpp_Runner.cppStandard": "gnu++11",
  "C_Cpp_Runner.msvcBatchPath": "C:/Program Files/Microsoft Visual Studio/VR_NR/Community/VC/Auxiliary/Build/vcvarsall.bat",
  "C_Cpp_Runner.useMsvc": false,
  "C_Cpp_Runner.warnings": [
    "-Wall",
    "-Wextra",
    "-Wpedantic",
    "-Wshadow",
    "-Wformat=2",
    "-Wcast-align",
    "-Wconversion",
    "-Wsign-conversion",
    "-Wnull-dereference"
  ],
  "C_Cpp_Runner.msvcWarnings": [
    "/W4",
    "/permissive-",
    "/w14242",
    "/w14287",
    "/w14296",
    "/w14311",
    "/w14826",
    "/w44062",
    "/w44242",
    "/w14905",
    "/w14906",
    "/w14263",
    "/w44265",
    "/w14928"
  ],
  "C_Cpp_Runner.enableWarnings": true,
  "C_Cpp_Runner.warningsAsError": false,
  "C_Cpp_Runner.compilerArgs": ["-fexceptions"],
  "C_Cpp_Runner.linkerArgs": [
    "-static-libgcc",
    "-static-libstdc++",
    "-LOpenGL/lib",
    "-lmingw32",
    "-lSDL2main",
    "-lSDL2",
    "-lSDL2_mixer",
    "-lopengl32",
    "-lfreeglut",
    "-lwinmm"
  ],
  "C_Cpp_Runner.includePaths": [".", "OpenGL/include", "OpenGL/include/SDL2"],
  "C_Cpp_Runner.includeSearch": [
    "*",
    "**/*"
  ],
  "C_Cpp_Runner.excludeSearch": [
    "**/build",
    "**/build/**",
    "**/.*",
    "**/.*/**",
    "**/.vscode",
    "**/.vscode/**"
  ],
  "C_Cpp_Runner.useAddressSanitizer": false,
  "C_Cpp_Runner.useUndefinedSanitizer": false,
  "C_Cpp_Runner.useLeakSanitizer": false,
  "C_Cpp_Runner.showCompilationTime": false,
  "C_Cpp_Runner.useLinkTimeOptimization": false,
  "C_Cpp_Runner.msvcSecureNoWarnings": false,
  "terminal.integrated.env.windows": {
    "PATH": "${workspaceFolder}\\bin;C:\\MinGW\\bin;${env:PATH}"
  },
  "code-runner.cwd": "$workspaceRoot",
  "code-runner.runInTerminal": true,
  "code-runner.ignoreSelection": true,
  "code-runner.saveFileBeforeRun": true,
  "code-runner.executorMap": {
    "cpp": ".\\runner.bat \"$fullFileName\""
  },
  "c-cpp-compile-run.cpp-compiler": "C:/MinGW/bin/g++.exe",
  "c-cpp-compile-run.cpp-flags": "-std=gnu++11 -Wall -fexceptions -g -I. -IOpenGL/include -IOpenGL/include/SDL2",
  "c-cpp-compile-run.cpp-linker-flags": "-static-libgcc -static-libstdc++ -LOpenGL/lib -lmingw32 -lSDL2main -lSDL2 -lSDL2_mixer -lopengl32 -lfreeglut -lwinmm",
  "c-cpp-compile-run.output-location": "bin"
}
