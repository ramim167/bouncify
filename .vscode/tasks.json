{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build BOUNCIFY",
      "type": "shell",
      "command": ".\\runner.bat",
      "args": ["--build-only"],
      "options": {
        "cwd": "${workspaceFolder}",
        "shell": { "executable": "cmd.exe", "args": ["/d", "/c"] }
      },
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "Run BOUNCIFY",
      "type": "shell",
      "command": ".\\runner.bat",
      "options": {
        "cwd": "${workspaceFolder}",
        "shell": { "executable": "cmd.exe", "args": ["/d", "/c"] }
      },
      "problemMatcher": ["$gcc"]
    }
  ]
}
